      setVan(baStart.x, baStart.y, initHeading);

      // --- Loop-in / loop-out scene crossfade (dip to flat background) ---
      tl.to("#scene", { opacity: 1, duration: 0.3, ease: "power1.out" }, 0);
      tl.to("#scene", { opacity: 0, duration: 0.4, ease: "power1.in" }, 6.6);

      // --- Text reveal (fade_blur) ---
      tl.to("#headline", { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.55, ease: "sine.out" }, 0.0);
      tl.to("#subdetail", { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.4, ease: "sine.out" }, 0.5);

      // --- Origin pulse: continuous radial ping from ~0.3s for the rest of the loop.
      // Finite repeat count (not -1) per the HF contract's "finite repeats only" rule; 7 cycles
      // at 1.1s each comfortably covers the 0.3s-6.6s window it needs to animate through. ---
      tl.fromTo(
        "#origin-pulse",
        { scale: 1, opacity: 0.6 },
        { scale: 2.2, opacity: 0, duration: 1.1, ease: "sine.out", repeat: 7 },
        0.3
      );

      // --- Phase 1: trunk draw-on + van travel, Buenos Aires -> fork (0.5s - 2.0s) ---
      var headingP1 = initHeading;
      var proxy1 = { p: 0 };
      tl.to(
        proxy1,
        {
          p: 1,
          duration: 1.5,
          ease: "power2.inOut",
          onUpdate: function () {
            var len = proxy1.p * Ltrunk;
            var pos = trunkPath.getPointAtLength(len);
            var h = headingAt(trunkSample, len, Ltrunk, 2);
            if (h !== null) headingP1 = lerp(headingP1, h, 0.35);
            setVan(pos.x, pos.y, headingP1);
            trunkPath.setAttribute("stroke-dashoffset", Ltrunk * (1 - proxy1.p));
          }
        },
        0.5
      );

      // --- Phase 2: branch-cordoba draw-on + van travel, fork -> Cordoba (2.0s - 2.4s) ---
      var cordobaSample = function (d) {
        return cordobaPath.getPointAtLength(clamp(d, 0, Lc));
      };
      var headingP2 = headingAt(cordobaSample, 0, Lc, 2) || headingP1;
      var proxy2 = { p: 0 };
      tl.to(
        proxy2,
        {
          p: 1,
          duration: 0.4,
          ease: "power2.inOut",
          onUpdate: function () {
            var len = proxy2.p * Lc;
            var pos = cordobaPath.getPointAtLength(len);
            var h = headingAt(cordobaSample, len, Lc, 2);
            if (h !== null) headingP2 = lerp(headingP2, h, 0.35);
            setVan(pos.x, pos.y, headingP2);
            cordobaPath.setAttribute("stroke-dashoffset", Lc * (1 - proxy2.p));
          }
        },
        2.0
      );

      // --- Cordoba arrival: one-time navy pin ping + van settle bounce (2.4s - ~2.65s) ---
      tl.to("#cordoba-ping", { scale: 1.3, duration: 0.2, ease: "back.out(1.6)" }, 2.4);
      tl.to("#cordoba-ping", { scale: 1, duration: 0.15, ease: "power2.out" }, 2.61);
      tl.to(vanBody, { scale: 1.15, duration: 0.1, ease: "power2.out" }, 2.4);
      tl.to(vanBody, { scale: 1, duration: 0.15, ease: "power2.inOut" }, 2.5);

      // --- Pattern-interrupt beat @2.6s: branch-salta draws on fast + amber ping fires ---
      tl.to(saltaPath, { attr: { strokeDashoffset: 0 }, duration: 0.4, ease: "power2.inOut" }, 2.6);
      tl.to("#salta-ping", { scale: 1.3, duration: 0.2, ease: "back.out(1.6)" }, 2.6);
      tl.to("#salta-ping", { scale: 1, duration: 0.15, ease: "power2.out" }, 2.81);

      // --- Phase 3: van departs Cordoba, back through the fork, on to Salta (2.6s - 4.5s) ---
      var Ltotal3 = Lc + Ls;
      var reverseSample = function (d) {
        d = clamp(d, 0, Ltotal3);
        if (d <= Lc) {
          return cordobaPath.getPointAtLength(Lc - d);
        }
        return saltaPath.getPointAtLength(d - Lc);
      };
      var headingP3 = headingAt(reverseSample, 0, Ltotal3, 2) || headingP2 + 180;
      var proxy3 = { p: 0 };
      tl.to(
        proxy3,
        {
          p: 1,
          duration: 1.9,
          ease: "power2.inOut",
          onUpdate: function () {
            var len = proxy3.p * Ltotal3;
            var pos = reverseSample(len);
            var h = headingAt(reverseSample, len, Ltotal3, 2);
            if (h !== null) headingP3 = lerp(headingP3, h, 0.35);
            setVan(pos.x, pos.y, headingP3);
          }
        },
        2.6
      );

      // --- Salta arrival: van settle bounce (4.5s - ~4.75s); the amber ping already fired at 2.6s ---
      tl.to(vanBody, { scale: 1.15, duration: 0.1, ease: "power2.out" }, 4.5);
      tl.to(vanBody, { scale: 1, duration: 0.15, ease: "power2.inOut" }, 4.6);

      // Held parked at Salta 4.8s - 6.6s (only the origin pulse keeps animating), then loop-out crossfade.

      window.__timelines["hero-envios-mapa"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
